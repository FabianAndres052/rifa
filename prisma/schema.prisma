generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum NumberStatus {
  AVAILABLE
  RESERVED
  SOLD_PAID
  SOLD_PENDING
}

enum AssignmentStatus {
  RESERVED
  PAID
  PENDING
}

enum PaymentType {
  TOTAL
  ABONO
}

model Administrator {
  id           String   @id @default(uuid()) @db.VarChar(64)
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(150)
  role         String   @default("ADMIN") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("administrators")
}

model Customer {
  id          String   @id @default(uuid()) @db.VarChar(64)
  fullName    String   @map("full_name") @db.VarChar(200)
  phone       String   @db.VarChar(50)
  address     String   @db.VarChar(255)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  numbers      RaffleNumber[]
  assignments  NumberAssignment[]
  payments     Payment[]

  @@map("customers")
}

model RaffleNumber {
  number     String       @id @db.VarChar(2)
  status     NumberStatus @default(AVAILABLE)
  price      Decimal      @default(40000.00) @db.Decimal(12, 2)
  customerId String?      @map("customer_id") @db.VarChar(64)
  updatedAt  DateTime     @updatedAt @map("updated_at")

  // Relaciones
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignment NumberAssignment?

  @@index([customerId])
  @@map("raffle_numbers")
}

model NumberAssignment {
  id         String           @id @default(uuid()) @db.VarChar(64)
  customerId String           @map("customer_id") @db.VarChar(64)
  number     String           @unique @db.VarChar(2)
  status     AssignmentStatus
  assignedAt DateTime         @default(now()) @map("assigned_at")
  notes      String?          @db.Text

  // Relaciones
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  raffle   RaffleNumber @relation(fields: [number], references: [number], onDelete: Cascade)

  @@index([customerId])
  @@map("number_assignments")
}

model Payment {
  id            String      @id @default(uuid()) @db.VarChar(64)
  customerId    String      @map("customer_id") @db.VarChar(64)
  amount        Decimal     @db.Decimal(12, 2)
  paymentType   PaymentType @default(TOTAL) @map("payment_type")
  paymentMethod String      @default("EFECTIVO") @map("payment_method") @db.VarChar(50)
  reference     String?     @db.VarChar(100)
  paidAt        DateTime    @default(now()) @map("paid_at")
  notes         String?     @db.Text

  // Relaciones
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("payments")
}

model RaffleDraw {
  id            String   @id @default(uuid()) @db.VarChar(64)
  title         String   @db.VarChar(150)
  prize         String   @db.VarChar(255)
  drawDate      DateTime @map("draw_date")
  lottery       String   @default("Sinuano Noche") @db.VarChar(100)
  isMain        Boolean  @default(false) @map("is_main")
  winningNumber String?  @map("winning_number") @db.VarChar(2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("raffle_draws")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(64)
  action      String   @db.VarChar(100)
  entity      String   @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  performedBy String   @default("admin") @map("performed_by") @db.VarChar(100)
  details     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
